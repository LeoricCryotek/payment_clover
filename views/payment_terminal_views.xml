<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Standalone Payment Terminal action.

        Opens a client-side form where staff can:
        1. Select a partner (customer/member)
        2. Enter an amount and description
        3. Process a card payment via Clover's iframe
    -->
    <record id="action_clover_payment_terminal" model="ir.actions.client">
        <field name="name">Clover Payment Terminal</field>
        <field name="tag">payment_clover.terminal</field>
        <field name="target">current</field>
    </record>

    <!-- Top-level Clover menu with sub-items -->
    <menuitem id="menu_clover_root"
              name="Clover"
              web_icon="payment_clover,static/description/icon.png"
              sequence="200"/>

    <menuitem id="menu_clover_terminal"
              name="Payment Terminal"
              parent="menu_clover_root"
              action="action_clover_payment_terminal"
              sequence="10"/>

    <menuitem id="menu_clover_transactions"
              name="Transaction Log"
              parent="menu_clover_root"
              action="action_clover_transactions"
              sequence="20"/>

    <menuitem id="menu_clover_report_wizard"
              name="Transaction Report"
              parent="menu_clover_root"
              action="action_clover_transaction_report_wizard"
              sequence="30"/>

</odoo>
