<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Standalone Payment Terminal action.

        Opens a client-side form where staff can:
        1. Select a partner (customer/member)
        2. Enter an amount and description
        3. Process a card payment via Clover's iframe
    -->
    <record id="action_clover_payment_terminal" model="ir.actions.client">
        <field name="name">Clover Payment Terminal</field>
        <field name="tag">payment_clover.terminal</field>
        <field name="target">current</field>
    </record>

    <!--
        Configuration action — opens the Clover payment provider form
        directly (skips the list when only one Clover provider exists).
        Used by both the admin-only Configuration menu and the gear
        button rendered inside the Payment Terminal client action.
    -->
    <record id="action_clover_provider_config" model="ir.actions.act_window">
        <field name="name">Clover Configuration</field>
        <field name="res_model">payment.provider</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('code', '=', 'clover')]</field>
        <field name="context">{'default_code': 'clover'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Clover provider yet.
            </p>
            <p>
                A Clover payment provider record is created automatically
                when this module installs. If you don't see one here, try
                reinstalling the module.
            </p>
        </field>
    </record>

    <!-- Top-level Clover menu — visible to anyone in the Clover Terminal category -->
    <menuitem id="menu_clover_root"
              name="Clover"
              web_icon="payment_clover,static/description/icon.png"
              sequence="200"
              groups="payment_clover.group_clover_user"/>

    <menuitem id="menu_clover_terminal"
              name="Payment Terminal"
              parent="menu_clover_root"
              action="action_clover_payment_terminal"
              sequence="10"
              groups="payment_clover.group_clover_user"/>

    <menuitem id="menu_clover_transactions"
              name="Transaction Log"
              parent="menu_clover_root"
              action="action_clover_transactions"
              sequence="20"
              groups="payment_clover.group_clover_user"/>

    <!-- Admin-only menus -->
    <menuitem id="menu_clover_report_wizard"
              name="Transaction Report"
              parent="menu_clover_root"
              action="action_clover_transaction_report_wizard"
              sequence="30"
              groups="payment_clover.group_clover_admin"/>

    <menuitem id="menu_clover_provider_config"
              name="Configuration"
              parent="menu_clover_root"
              action="action_clover_provider_config"
              sequence="100"
              groups="payment_clover.group_clover_admin"/>

</odoo>
