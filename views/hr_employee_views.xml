<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Add a "Clover" tab to the hr.employee form so a manager can
        open any employee and see their Clover POS activity: sales
        rung, tips collected (personal / gratuity / unclaimed
        breakdown), and the mirror links. Also expose the year-to-date
        rollups on the header for quick reporting.
    -->
    <record id="hr_employee_form_clover" model="ir.ui.view">
        <field name="name">hr.employee.form.clover</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!--
                Top-bar hot button. Visible on paid employees who
                aren't yet linked to a Clover account. Clicking it
                calls the push, which also writes back the matching
                clover.employee mirror so the mapping is in place
                without any extra steps.
            -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_push_to_clover"
                            type="object"
                            string="Create Clover Account"
                            class="btn-primary"
                            icon="fa-id-card"
                            invisible="not x_clover_push_eligible"
                            groups="payment_clover.group_clover_admin"
                            confirm="Create a Clover employee account
                                     for this person with the role
                                     and 6-digit login code shown on
                                     the Clover POS tab? The matching
                                     Clover Employee mirror record
                                     will be created and linked back
                                     automatically."
                            help="Opens on top-bar for admins so a
                                  new paid hire can be onboarded to
                                  Clover without digging into the
                                  Clover POS tab. Hidden on
                                  Volunteers and on employees who
                                  are already linked to a Clover
                                  cashier."/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Clover POS" name="clover_pos"
                      groups="payment_clover.group_clover_user">
                    <!--
                        Create Clover Account banner. Visible for
                        ANY employee not yet linked — volunteers
                        included (their tips just land as unclaimed
                        because their department is flagged
                        x_clover_tips_eligible = False, but they
                        still need a login to run the terminal).
                    -->
                    <div class="alert alert-info mb-3" role="alert"
                         invisible="not x_clover_push_eligible"
                         groups="payment_clover.group_clover_admin">
                        <i class="fa fa-id-card me-1"
                           title="Information"/>
                        <strong>Create a Clover login for this
                        employee.</strong>
                        Pick a <b>Clover Role</b> below, confirm the
                        auto-generated 6-digit login code, then
                        click <b>Create Clover Account</b> in the
                        header. The code is the last 4 digits of the
                        phone number repeated to 6 characters
                        (e.g. 208-553-4086 → 408640). Available for
                        every employee — tip eligibility is a
                        separate concept controlled by the
                        department.
                    </div>
                    <group>
                        <group string="Clover Setup"
                               invisible="not x_clover_push_eligible and not x_clover_employee_ids"
                               groups="payment_clover.group_clover_admin">
                            <field name="x_clover_role"
                                   invisible="not x_clover_push_eligible"/>
                            <field name="x_clover_login_code"
                                   readonly="1"/>
                            <field name="x_clover_push_eligible"
                                   invisible="1"/>
                        </group>
                        <group string="This Employee's Clover Activity">
                            <field name="x_clover_auto_created"
                                   readonly="1"/>
                            <field name="x_clover_tips_this_period"
                                   readonly="1"
                                   widget="monetary"/>
                            <field name="x_clover_tips_ytd"
                                   readonly="1"
                                   widget="monetary"/>
                            <field name="x_clover_sales_ytd"
                                   readonly="1"
                                   widget="monetary"/>
                            <field name="x_clover_sales_count_ytd"
                                   readonly="1"/>
                        </group>
                        <group string="Clover Employee Mirror(s)">
                            <field name="x_clover_employee_ids"
                                   nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="nickname"/>
                                    <field name="email"/>
                                    <field name="role"/>
                                    <field name="is_float"/>
                                    <field name="exclude_from_reports"/>
                                </list>
                            </field>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recent Tips" name="clover_tips">
                            <field name="x_clover_tip_ids"
                                   nolabel="1" readonly="1"
                                   options="{'default_order': 'date desc'}">
                                <list default_order="date desc"
                                      decoration-muted="is_refunded or is_event_gratuity or is_unclaimed">
                                    <field name="date"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="is_event_gratuity"/>
                                    <field name="is_unclaimed"/>
                                    <field name="is_refunded"/>
                                    <field name="clover_sale_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Recent Sales" name="clover_sales">
                            <field name="x_clover_sale_ids"
                                   nolabel="1" readonly="1">
                                <list default_order="date desc">
                                    <field name="date"/>
                                    <field name="clover_order_id"/>
                                    <field name="total_amount"
                                           sum="Total"/>
                                    <field name="tip_amount"
                                           sum="Tips"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
