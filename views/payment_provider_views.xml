<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend the payment provider form to show Clover fields -->
    <record id="payment_provider_form_clover" model="ir.ui.view">
        <field name="name">payment.provider.form.clover</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <div class="alert alert-info mb-3" role="alert"
                     colspan="2"
                     invisible="code != 'clover' or state == 'enabled'">
                    <strong>Tip:</strong> You can save in Disabled or Test
                    mode without credentials. Fill them in, then switch to
                    Enabled when ready.
                </div>
                <group invisible="code != 'clover'" string="Clover API Credentials">
                    <field name="clover_api_key"
                           password="True"
                           placeholder="Ecommerce eComm Iframe → PRIVATE token (charges/refunds)"
                           required="state == 'enabled' and code == 'clover'"/>
                    <field name="clover_platform_api_key"
                           password="True"
                           placeholder="REST API token with Inventory READ (item sync) — optional"/>
                    <field name="clover_pakms_key"
                           placeholder="Ecommerce eComm Iframe → PUBLIC token (browser tokenization)"
                           required="state == 'enabled' and code == 'clover'"/>
                    <field name="clover_merchant_id"
                           placeholder="e.g. 100235230883"
                           required="state == 'enabled' and code == 'clover'"/>
                    <field name="clover_webhook_secret"
                           password="True"
                           placeholder="Optional — HMAC secret for webhook signature verification"/>
                </group>
                <div class="alert alert-danger mb-2" role="alert"
                     colspan="2"
                     invisible="code != 'clover'">
                    <i class="fa fa-exclamation-triangle me-1"
                       title="Warning"/>
                    <strong>Do not use Odoo POS with Clover.</strong>
                    This module intentionally does NOT integrate with
                    Odoo POS. Sales rung in Odoo POS become pos.order
                    records that never reach Clover, so your Clover
                    daily-close reports, Clover-side inventory, and
                    the QBO reconciliation your bookkeeper does from
                    Clover will all be missing those sales. Keep
                    Clover as the sole physical point-of-sale.
                    Payment through Clover in Odoo happens only via
                    the website checkout (/shop/payment) and the
                    staff Clover Terminal screen shipped with this
                    module.
                </div>
                <group invisible="code != 'clover'" string="Clover Sync Engine (read-only, silent)">
                    <field name="clover_sync_sales"/>
                    <field name="clover_auto_create_sale_orders"
                           invisible="not clover_sync_sales"/>
                    <field name="clover_auto_create_partners"
                           invisible="not clover_sync_sales"/>
                    <field name="clover_new_employee_behavior"
                           invisible="not clover_sync_sales"/>
                    <field name="clover_sync_item_costs"
                           invisible="not clover_sync_sales"/>
                    <field name="clover_last_sales_sync_at" readonly="1"
                           invisible="not clover_sync_sales"/>
                    <field name="clover_last_employee_sync_at" readonly="1"
                           invisible="not clover_sync_sales"/>
                </group>
                <group invisible="code != 'clover' or not clover_sync_sales"
                       string="Auto-Sync Schedule">
                    <field name="clover_sync_frequency"/>
                    <field name="clover_sync_interval_hours"
                           invisible="clover_sync_frequency != 'hourly'"
                           required="clover_sync_frequency == 'hourly'"/>
                    <field name="clover_sync_hour"
                           invisible="clover_sync_frequency != 'daily'"
                           required="clover_sync_frequency == 'daily'"/>
                    <field name="clover_next_scheduled_sync_at"
                           readonly="1"
                           invisible="clover_sync_frequency == 'manual'"/>
                    <button name="action_clover_apply_schedule"
                            type="object"
                            string="Apply Schedule Now"
                            class="btn-link"
                            icon="fa-clock-o"
                            colspan="2"
                            help="Re-writes the underlying scheduled
                                  action from these settings. Normally
                                  saved automatically when you change
                                  these fields — click this if the
                                  'Next Auto-Sync At' shown above
                                  looks wrong."/>
                </group>
            </group>

            <!-- Sync Items button in the header -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_sync_clover_items"
                            string="Sync Items from Clover"
                            type="object"
                            class="btn-secondary"
                            icon="fa-refresh"
                            invisible="code != 'clover' or state == 'disabled'"
                            confirm="This will fetch all items from your Clover inventory. Continue?"/>
                    <button name="action_sync_clover_employees"
                            string="Sync Employees from Clover"
                            type="object"
                            class="btn-secondary"
                            icon="fa-users"
                            invisible="code != 'clover' or state == 'disabled'"
                            help="Pulls every Clover cashier into the Clover Employees tab below. Runs the employee sync only — no sales, no tips. Use this to populate the mapping list before running a full sync."/>
                    <button name="action_clover_open_preview"
                            string="Preview Sync (Dry Run)"
                            type="object"
                            class="btn-secondary"
                            icon="fa-search"
                            invisible="code != 'clover' or not clover_sync_sales"/>
                    <button name="action_clover_recompute_sale_line_links"
                            string="Recompute Sale-Line Links"
                            type="object"
                            class="btn-link"
                            icon="fa-magic"
                            invisible="code != 'clover' or not clover_sync_sales"
                            help="Re-runs the product_id compute + backfills unit_qty=1 on every clover.sale.line. Use after linking a Clover Item to a product, or when historical lines from an early sync are missing product attribution."/>
                </header>
            </xpath>

            <!-- Clover Items notebook page -->
            <xpath expr="//notebook" position="inside">
                <page string="Clover Items"
                      invisible="code != 'clover'"
                      name="clover_items">
                    <field name="clover_item_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name" readonly="1"/>
                            <field name="clover_item_id" readonly="1"/>
                            <field name="price" readonly="1"/>
                            <field name="cost" readonly="1"/>
                            <field name="price_type" readonly="1"/>
                            <field name="sku" readonly="1"/>
                            <field name="category_name" readonly="1"/>
                            <field name="product_id"/>
                            <field name="exclude_from_employee_tips"/>
                            <field name="active" readonly="1"/>
                            <field name="last_synced" readonly="1"/>
                        </list>
                    </field>
                </page>
                <page string="Clover Employees"
                      invisible="code != 'clover'"
                      name="clover_employees">
                    <div class="alert alert-info mb-2" role="alert">
                        <i class="fa fa-info-circle me-1"
                           title="Info"/>
                        <strong>Employee Mapping.</strong>
                        Every Clover cashier lives here. Set the
                        <b>Odoo Employee</b> column to link a Clover
                        account to one of your hr.employees — search
                        by any part of the name (e.g. "Jon Longtin"
                        finds "Jon Longtin - Bartender"). Setting or
                        changing this field
                        <b>retroactively re-attributes</b> all
                        historical clover.sale and clover.tip.entry
                        rows for that cashier to the newly-mapped
                        employee. If the roster is empty or stale,
                        click <b>Sync Employees from Clover</b> at
                        the top of this page to refresh it.
                    </div>
                    <!--
                        Non-editable list + popup form.

                        Odoo 19 has a known bug where editable
                        one2many lists embedded in a parent form
                        crash on save with
                            undefined is not an object
                            (evaluating 'this.editedRecord.save')
                        when the parent form's Save button runs
                        before the list has committed the pending
                        row edit. The workaround is to drop
                        editable="bottom" here and provide a
                        <form> popup instead — users click a row,
                        pick an employee in the dialog, and the
                        row is saved cleanly before the parent
                        form sees it.
                    -->
                    <field name="clover_employee_ids" nolabel="1"
                           mode="list">
                        <list decoration-warning="mapping_status == 'pending'"
                              decoration-muted="mapping_status == 'excluded'"
                              decoration-info="mapping_status == 'mapped'"
                              create="false" delete="false">
                            <field name="mapping_status" readonly="1"
                                   widget="badge"
                                   decoration-warning="mapping_status == 'pending'"
                                   decoration-muted="mapping_status == 'excluded'"
                                   decoration-info="mapping_status == 'mapped'"/>
                            <field name="name"/>
                            <field name="nickname" optional="hide"/>
                            <field name="email"/>
                            <field name="role"/>
                            <field name="employee_id"/>
                            <field name="is_float"/>
                            <field name="exclude_from_reports"/>
                            <field name="last_synced" optional="hide"/>
                        </list>
                        <form string="Map Clover Employee">
                            <header>
                                <button name="action_open_remap_wizard"
                                        type="object"
                                        string="Remap with Effective Date"
                                        class="btn-secondary"
                                        icon="fa-clock-o"
                                        help="Open the remap wizard to
                                              pick a date/time cutoff —
                                              only records on or after
                                              it move; earlier records
                                              stay with the current
                                              mapping."/>
                            </header>
                            <sheet>
                                <div class="alert alert-info mb-2"
                                     role="alert">
                                    <i class="fa fa-info-circle me-1"
                                       title="Info"/>
                                    Pick the matching
                                    <b>Odoo Employee</b> from the
                                    dropdown — saving will
                                    retroactively re-attribute
                                    <b>every</b> historical sale and
                                    tip for this cashier. If you only
                                    want records from a specific
                                    moment forward to move, click
                                    <b>Remap with Effective Date</b>
                                    above instead.
                                </div>
                                <group>
                                    <group string="From Clover">
                                        <field name="name"
                                               readonly="1"/>
                                        <field name="nickname"
                                               readonly="1"/>
                                        <field name="email"
                                               readonly="1"/>
                                        <field name="role"
                                               readonly="1"/>
                                        <field name="clover_employee_id"
                                               readonly="1"/>
                                    </group>
                                    <group string="Mapping">
                                        <field name="mapping_status"
                                               widget="badge"
                                               readonly="1"
                                               decoration-warning="mapping_status == 'pending'"
                                               decoration-muted="mapping_status == 'excluded'"
                                               decoration-info="mapping_status == 'mapped'"/>
                                        <field name="employee_id"
                                               options="{'no_create': True}"
                                               placeholder="Search hr.employees…"/>
                                        <field name="is_float"
                                               readonly="1"/>
                                        <field name="exclude_from_reports"/>
                                        <field name="last_synced"
                                               readonly="1"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Clover Item list view -->
    <record id="clover_item_view_list" model="ir.ui.view">
        <field name="name">clover.item.list</field>
        <field name="model">clover.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="clover_item_id"/>
                <field name="price" string="Price ($)"/>
                <field name="price_type"/>
                <field name="sku"/>
                <field name="category_name"/>
                <field name="provider_id"/>
                <field name="product_id"/>
                <field name="last_synced"/>
            </list>
        </field>
    </record>

    <!-- Clover Item form view -->
    <record id="clover_item_view_form" model="ir.ui.view">
        <field name="name">clover.item.form</field>
        <field name="model">clover.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Clover Details">
                            <field name="name"/>
                            <field name="clover_item_id"/>
                            <field name="provider_id"/>
                            <field name="price"/>
                            <field name="price_type"/>
                            <field name="sku"/>
                            <field name="category_name"/>
                        </group>
                        <group string="Odoo Link">
                            <field name="product_id"/>
                            <field name="active"/>
                            <field name="hidden"/>
                            <field name="last_synced"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Clover Items action -->
    <record id="clover_item_action" model="ir.actions.act_window">
        <field name="name">Clover Items</field>
        <field name="res_model">clover.item</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Clover items synced yet.
            </p>
            <p>
                Go to Payment Providers → Clover and click
                "Sync Items from Clover" to import your inventory.
            </p>
        </field>
    </record>

</odoo>
