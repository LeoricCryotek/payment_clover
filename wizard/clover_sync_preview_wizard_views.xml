<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Preview / dry-run wizard for a Clover sync.

        Opened from the "Preview Clover Data" menu (admin only) and
        the header button on the Clover payment.provider form. Fetches
        the last N Clover orders + all Clover employees, runs the same
        matching / dedup / auto-create decisions the real sync would
        run, and shows the admin the outcome. Commits nothing until
        the admin clicks "Commit These Changes".
    -->
    <record id="clover_sync_preview_wizard_view_form" model="ir.ui.view">
        <field name="name">clover.sync.preview.wizard.form</field>
        <field name="model">clover.sync.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Clover Sync — Preview">
                <header>
                    <button name="action_refresh_preview"
                            type="object"
                            string="Refresh Preview"
                            class="btn-secondary"
                            icon="fa-refresh"/>
                    <button name="action_commit_preview"
                            type="object"
                            string="Commit These Changes"
                            class="btn-primary"
                            icon="fa-check"
                            confirm="This will run the REAL Clover sync. It pulls everything modified since the last successful sync (or all data on the first run), which may be more than what this preview shows. Continue?"/>
                </header>
                <sheet>
                    <div class="alert alert-info mb-3" role="alert">
                        <strong>Dry-run preview.</strong>
                        Nothing here is committed to the database.
                        The employees and orders below show exactly
                        what the sync WOULD do if you clicked
                        "Commit These Changes" — no partners created,
                        no hr.employees added, no mirror rows written.
                        Use this to check for wrong-name matches or
                        unexpected auto-creates before flipping the
                        real sync on.
                    </div>
                    <group>
                        <group>
                            <field name="provider_id"
                                   options="{'no_create': True}"
                                   required="1"/>
                            <field name="sample_size"/>
                        </group>
                        <group>
                            <field name="fetched_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>

                        <!-- ============================= -->
                        <!-- Summary tab                   -->
                        <!-- ============================= -->
                        <page string="Summary" name="summary">
                            <group>
                                <group string="Employees">
                                    <field name="count_emp_link_existing" readonly="1"/>
                                    <field name="count_emp_auto_create" readonly="1"/>
                                    <field name="count_emp_already_linked" readonly="1"/>
                                    <field name="count_emp_float" readonly="1"/>
                                </group>
                                <group string="Sales / Contacts">
                                    <field name="count_sale_create" readonly="1"/>
                                    <field name="count_sale_update" readonly="1"/>
                                    <field name="count_partner_match" readonly="1"/>
                                    <field name="count_partner_create" readonly="1"/>
                                    <field name="count_partner_skip" readonly="1"/>
                                </group>
                            </group>
                            <div class="alert alert-warning mt-3" role="alert"
                                 invisible="count_emp_auto_create == 0 and count_partner_create == 0">
                                <strong>Check auto-creates carefully.</strong>
                                Auto-created hr.employees and res.partners
                                cannot be safely deleted after commit if
                                other Odoo records reference them. Fix
                                the source (add the employee manually,
                                update the contact's phone/email) BEFORE
                                committing whenever possible.
                            </div>
                        </page>

                        <!-- ============================= -->
                        <!-- Employees tab                 -->
                        <!-- ============================= -->
                        <page string="Employees" name="employees">
                            <div class="alert alert-info mb-2" role="alert">
                                <i class="fa fa-info-circle me-1"
                                   title="Info"/>
                                <strong>Click any row to edit.</strong>
                                A dialog opens where you can change the
                                <b>Action</b> and pick a
                                <b>Matched Employee</b> from all your
                                hr.employees (search by any part of
                                their name, e.g. "Jon Longtin" to find
                                "Jon Longtin - Bartender"). Your picks
                                are what the commit uses — nothing
                                re-runs the matcher.
                            </div>
                            <field name="employee_line_ids"
                                   nolabel="1"
                                   context="{'form_view_ref': 'payment_clover.clover_sync_preview_employee_view_form'}">
                                <list create="false" delete="false"
                                      decoration-warning="action == 'create'"
                                      decoration-muted="action in ('float','unchanged','skip')"
                                      decoration-info="action == 'link'">
                                    <field name="name"/>
                                    <field name="nickname" optional="hide"/>
                                    <field name="email"/>
                                    <field name="role"/>
                                    <field name="action"/>
                                    <field name="matched_employee_id"/>
                                    <field name="candidate_employee_ids"
                                           widget="many2many_tags"
                                           optional="show"/>
                                    <field name="match_reason"/>
                                </list>
                            </field>
                        </page>

                        <!-- ============================= -->
                        <!-- Sales tab                     -->
                        <!-- ============================= -->
                        <page string="Sales" name="sales">
                            <div class="alert alert-info mb-2" role="alert">
                                <i class="fa fa-info-circle me-1"
                                   title="Info"/>
                                Click any order to see the <b>Line
                                Items</b> — individual products, per-
                                line amounts, quantities. These land
                                as <b>clover.sale.line</b> children on
                                commit and are visible from the
                                Clover Sales list too.
                            </div>
                            <field name="sale_line_ids" readonly="1"
                                   nolabel="1"
                                   context="{'form_view_ref': 'payment_clover.clover_sync_preview_sale_view_form'}">
                                <list decoration-warning="partner_action == 'create'"
                                      decoration-muted="partner_action == 'skip'"
                                      decoration-info="sale_action == 'update'">
                                    <field name="date"/>
                                    <field name="cashier_name"/>
                                    <field name="customer_name"/>
                                    <field name="customer_phone" optional="hide"/>
                                    <field name="customer_email" optional="hide"/>
                                    <field name="total_amount" sum="Total"/>
                                    <field name="tip_amount" sum="Tips"/>
                                    <field name="line_count"/>
                                    <field name="sale_action"/>
                                    <field name="partner_action"/>
                                    <field name="matched_partner_id"/>
                                    <field name="partner_reason"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
                <footer>
                    <button string="Close"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!--
        Row-edit dialog for a single employee preview line.

        Opened when the admin clicks a row in the Employees tab list.
        Lets them override the auto-matcher's decision: change the
        Action to 'Link to existing hr.employee' and pick a specific
        target from the full hr.employee dropdown, or Skip / mark as
        Float — whatever fits the situation.
    -->
    <record id="clover_sync_preview_employee_view_form" model="ir.ui.view">
        <field name="name">clover.sync.preview.employee.form</field>
        <field name="model">clover.sync.preview.employee</field>
        <field name="arch" type="xml">
            <form string="Edit Employee Preview Row">
                <sheet>
                    <group>
                        <group string="From Clover (read-only)">
                            <field name="name" readonly="1"/>
                            <field name="nickname" readonly="1"/>
                            <field name="email" readonly="1"/>
                            <field name="role" readonly="1"/>
                            <field name="clover_employee_id"
                                   readonly="1"/>
                        </group>
                        <group string="What Commit Will Do">
                            <field name="action"/>
                            <field name="matched_employee_id"
                                   options="{'no_create': True}"
                                   required="action == 'link'"
                                   invisible="action != 'link'"
                                   placeholder="Search any hr.employee — type a name…"/>
                            <field name="candidate_employee_ids"
                                   widget="many2many_tags"
                                   readonly="1"
                                   invisible="not candidate_employee_ids"/>
                        </group>
                    </group>
                    <group string="Auto-Matcher's Reason">
                        <field name="match_reason" nolabel="1"
                               readonly="1"/>
                    </group>
                    <div class="alert alert-info mt-2" role="alert">
                        <strong>Actions explained:</strong><br/>
                        &#8226; <b>Link to existing hr.employee</b> —
                        wire this Clover cashier to an Odoo employee
                        you pick from the dropdown. Use this for
                        suffixed names (e.g., Clover "Jon Longtin"
                        → Odoo "Jon Longtin - Bartender").<br/>
                        &#8226; <b>Auto-create hr.employee</b> —
                        commit will silently create a new hr.employee
                        in the Clover Import (Review) department.<br/>
                        &#8226; <b>Already linked</b> — no change; the
                        clover.employee mirror already points at the
                        right hr.employee from a previous sync.<br/>
                        &#8226; <b>Float / excluded</b> — mark as
                        Clover Float profile so tips stay out of
                        personal reports; no hr.employee link.<br/>
                        &#8226; <b>Skip this employee</b> — do nothing
                        at all. Useful for archived Clover cashiers
                        who no longer work here.
                    </div>
                </sheet>
                <footer>
                    <button string="Save"
                            special="save"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!--
        Line-item drill-down for a preview sale row. Clicking a sale
        row in the wizard opens this form and shows the actual
        items on the Clover order — so admin can catch garbage line
        names or wildly-off pricing before committing.
    -->
    <record id="clover_sync_preview_sale_view_form" model="ir.ui.view">
        <field name="name">clover.sync.preview.sale.form</field>
        <field name="model">clover.sync.preview.sale</field>
        <field name="arch" type="xml">
            <form string="Clover Order Preview" create="false"
                  delete="false" edit="false">
                <sheet>
                    <group>
                        <group string="Order">
                            <field name="clover_order_id"/>
                            <field name="date"/>
                            <field name="cashier_name"/>
                            <field name="total_amount"/>
                            <field name="tip_amount"/>
                            <field name="line_count"/>
                        </group>
                        <group string="Customer + Sync Decisions">
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                            <field name="customer_email"/>
                            <field name="sale_action"/>
                            <field name="partner_action"/>
                            <field name="matched_partner_id"/>
                            <field name="partner_reason"/>
                        </group>
                    </group>
                    <group string="Line Items (from Clover)"
                           invisible="not line_summary">
                        <field name="line_summary" nolabel="1"
                               widget="text"/>
                    </group>
                    <div class="alert alert-info mt-2" role="alert"
                         invisible="line_summary">
                        <i class="fa fa-info-circle me-1"
                           title="Info"/>
                        Clover returned no line items for this order.
                        This usually means the order was cancelled or
                        the line items were deleted after posting.
                        On commit, a clover.sale row will still be
                        created with the header info, but no
                        clover.sale.line children.
                    </div>
                </sheet>
                <footer>
                    <button string="Close"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Menu-launched entry point — searches for the sole enabled
         Clover provider and opens the wizard, or warns if none. -->
    <record id="action_clover_preview_menu" model="ir.actions.server">
        <field name="name">Clover Sync — Preview</field>
        <field name="model_id" ref="payment.model_payment_provider"/>
        <field name="state">code</field>
        <field name="code">action = env['payment.provider'].action_clover_open_preview_menu()</field>
    </record>

    <menuitem id="menu_clover_sync_preview"
              name="Preview Sync (Dry Run)"
              parent="menu_clover_sales_root"
              action="action_clover_preview_menu"
              sequence="80"
              groups="payment_clover.group_clover_admin"/>

</odoo>
