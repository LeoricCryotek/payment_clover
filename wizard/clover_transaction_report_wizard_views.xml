<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Report Wizard — Form                                         -->
    <!-- ============================================================ -->
    <record id="clover_transaction_report_wizard_form" model="ir.ui.view">
        <field name="name">clover.transaction.report.wizard.form</field>
        <field name="model">clover.transaction.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Clover Transaction Log">
                <group>
                    <group string="Date Range">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group string="Options">
                        <field name="state_filter"/>
                        <field name="output_type" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate"
                            string="Generate Report"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Report Wizard — Action (opens as modal)                      -->
    <!-- ============================================================ -->
    <record id="action_clover_transaction_report_wizard" model="ir.actions.act_window">
        <field name="name">Clover Transaction Log</field>
        <field name="res_model">clover.transaction.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
